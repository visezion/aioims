{
  "name": "aims-noc-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "app:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-app.ps1",
    "app:start": ".venv\\Scripts\\python.exe scripts\\local_app.py",
    "dev": "vite --host=0.0.0.0 --port=4173 --strictPort",
    "api": ".venv\\Scripts\\python.exe python_backend\\server.py --port 8001",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": ".venv\\Scripts\\python.exe -m alembic -c alembic.ini upgrade head",
    "backup:db": ".venv\\Scripts\\python.exe scripts\\backup_database.py",
    "test:api": ".venv\\Scripts\\python.exe -m unittest discover -s tests",
    "test:backend": "cd python_backend && ..\\.venv\\Scripts\\python.exe -m unittest discover -s tests"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "leaflet": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/leaflet": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
